// Cloudflare Worker of Probe.EXE: passive collector (Cron Trigger) and read API.
{
	"name": "probe-exe-collector",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	// no public address: the page reaches this Worker through a service binding (pages/)
	"workers_dev": false,
	"preview_urls": false,
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "probe-exe",
			"database_id": "9538840a-5508-43f9-9b4d-b6ceae75087c"
		}
	],
	// Requests that reach the Worker missed the cache of the page (pages/functions/api): at most
	// this many per minute from one address, in one Cloudflare location.
	"ratelimits": [
		{
			"name": "API_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 120,
				"period": 60
			}
		}
	],
	"vars": {
		"RPC_URL": "https://rpc-bradbury.genlayer.com",
		// sender of the daily campaign: its transactions to the reference contracts are the [CAMP] source
		"CAMPAIGN_WALLET": "0xe8EFc2E93bCBEDaAb435873fF873e74745A4a4eF",
		// where an empty store starts reading: the first block of 2026-10-01 UTC
		"START_BLOCK": "23243920"
	},
	"observability": {
		"enabled": true
	}
}